{
  "name": "readerd",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "A quiet PDF reading companion for ReaderC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HopeLeeee/readerd.git"
  },
  "homepage": "https://github.com/HopeLeeee/readerd#readme",
  "bugs": {
    "url": "https://github.com/HopeLeeee/readerd/issues"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tools/smoke.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "format": "prettier --write src/app.mjs src/style.css electron/*.mjs index.html",
    "smoke:ai": "node tools/ai-smoke.mjs",
    "smoke:navigation": "node tools/navigation-smoke.mjs",
    "smoke:external-open": "node tools/external-open-smoke.mjs",
    "smoke:onboarding": "node tools/onboarding-smoke.mjs",
    "smoke:codex": "node tools/codex-smoke.mjs",
    "smoke:hover-speed": "node tools/hover-speed-smoke.mjs",
    "smoke:portable": "node tools/portable-smoke.mjs",
    "smoke:codex-cancel": "node tools/codex-cancel-smoke.mjs",
    "smoke:regression": "node tools/audit-ai-repro.mjs && node tools/audit-prefetch-repro.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10"
  },
  "build": {
    "appId": "io.hopeleeee.readerd",
    "productName": "ReaderD",
    "directories": {
      "output": "release/0.2.2"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "index.html",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ReaderD-${version}.exe"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "author": "HopeLeeee"
}
